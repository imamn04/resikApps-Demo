# Database Configuration (MySQL)
# Untuk Docker Compose (Default):
DATABASE_URL="mysql://resik_user:resik_password@mysql:3306/resik_db"

# Untuk Development Lokal tanpa Docker (XAMPP / MySQL Lokal):
