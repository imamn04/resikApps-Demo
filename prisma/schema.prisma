datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

model User {
  id           String      @id @default(uuid())
  name         String
  username     String      @unique
  email        String?     @unique
  password     String
  role         String      @default("STAFF_INPUT") // OWNER, ADMIN, STAFF_INPUT, VIEWER
  phone        String?
  isActive     Boolean     @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  createdJobs    Job[]       @relation("JobCreatedBy")
  updatedJobs    Job[]       @relation("JobUpdatedBy")
  uploadedPhotos JobPhoto[]
  auditLogs      AuditLog[]

  @@map("users")
}

model Customer {
  id          String   @id @default(uuid())
  name        String
  phone       String   @unique
  address     String   @db.Text
  notes       String?  @db.Text
  totalOrders Int      @default(0)
  totalSpent  Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobs Job[]

  @@map("customers")
}

model Service {
  id           Int      @id @default(autoincrement())
  name         String
  category     String   // CLEANING, AC, KELISTRIKAN, LAINNYA
  defaultPrice Float    @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  jobs Job[]

  @@map("services")
}

model Job {
  id             String    @id @default(uuid())
  jobNumber      String    @unique
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id])
  serviceId      Int
  service        Service   @relation(fields: [serviceId], references: [id])
  jobDetails     String?   @db.Text
  scheduledDate  String    // YYYY-MM-DD
  scheduledTime  String?   // HH:mm
  technicianName String?
  basePrice      Float     @default(0)
  extraFee       Float     @default(0)
  discount       Float     @default(0)
  totalPrice     Float     @default(0)
  status         String    @default("PENDING") // PENDING, DIJADWALKAN, DALAM_PENGERJAAN, SELESAI, DIBATALKAN
  notes          String?   @db.Text
  createdById    String
  createdBy      User      @relation("JobCreatedBy", fields: [createdById], references: [id])
  updatedById    String?
  updatedBy      User?     @relation("JobUpdatedBy", fields: [updatedById], references: [id])
  completedAt    DateTime?
  isDeleted      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  photos    JobPhoto[]
  auditLogs AuditLog[]

  @@map("jobs")
}

model JobPhoto {
  id           String   @id @default(uuid())
  jobId        String
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  photoType    String   // BEFORE, AFTER
  filePath     String
  fileName     String
  fileSize     Int?
  caption      String?  @db.Text
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@map("job_photos")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // CREATE, UPDATE, STATUS_CHANGE, DELETE, LOGIN
  entity    String   // JOB, CUSTOMER, USER, SERVICE
  entityId  String?
  details   String?  @db.Text // JSON string or notes
  ipAddress String?
  jobId     String?
  job       Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("audit_logs")
}
